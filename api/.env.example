# FileCast API — local dev config. Copy to `api/.env` (gitignored).
# Dev values below are fine as-is for local-first development.

ENVIRONMENT=development

# Postgres. In docker-compose the api service gets DATABASE_URL from compose
# (host `postgres`); this value is for running seed.py / alembic from the HOST,
# where Postgres is reachable on localhost:5432 (the mapped port).
DATABASE_URL=postgresql+psycopg://filecast:filecast_dev@localhost:5432/filecast
POSTGRES_PASSWORD=filecast_dev

# Sessions / cookies
SESSION_TTL_DAYS=30
# Leave COOKIE_DOMAIN unset locally; ".filecast.org" only in prod (Phase 7).
# COOKIE_DOMAIN=
COOKIE_SECURE=false
SITE_ORIGIN=http://localhost:8000

# Anti-abuse
FINGERPRINT_SALT=dev-salt
# Comma-separated peer IPs allowed to set X-Forwarded-For; empty locally.
TRUSTED_PROXIES=

# Retention
RETENTION_DAYS=30

# Google OAuth (Phase 5) — OPTIONAL. Only needed to test real Google sign-in
# locally; dev-login works without it. Leave the id/secret blank and the Google
# auth routes return 503 (header button lands on a 503 page) — that's expected,
# not a break. Create a Google Cloud "Web application" OAuth client with the
# redirect URI below, consent screen in Testing with your account as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8090/api/v1/auth/google/callback

# Phase 5.5 — staff bootstrap. Comma-separated allow-list of owner emails that are
# ALWAYS admin when they sign in with Google (break-glass; never revocable via the
# admin UI). This REPLACES hand-editing users.role in the DB. REQUIRED in production:
# with it empty and no existing admin, no account can ever become admin (the API
# logs a startup WARNING in that case). Further admins are granted in-app by an
# existing admin. Emails are matched case-insensitively.
INITIAL_ADMIN_EMAILS=

# Dev cookie gotcha: use `localhost` consistently — a cookie set for host
# `localhost` is NOT sent to `127.0.0.1` and vice-versa. Same-site fetch
# :8000 -> :8090 works because ports don't affect same-site.

# GitHub deploy trigger (Phase 7) — OPTIONAL, prod only. Powers the admin
# "Publish" button (admin_deploy.py), which dispatches the deploy.yml workflow
# via the GitHub API. Leave blank locally; the deploy-trigger routes return 501
# when unset (see admin_deploy.py) instead of breaking.
GITHUB_PAT=
GITHUB_OWNER=
GITHUB_REPO=

# Backend error tracking (Phase 9 §9.2) — OPTIONAL. Empty means
# sentry_sdk.init() is never called (main.py checks before calling it).
SENTRY_DSN=
# Fraction of requests to capture as performance traces (0.0-1.0). No effect
# unless SENTRY_DSN is set.
SENTRY_TRACES_SAMPLE_RATE=1.0
