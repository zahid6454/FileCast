# FileCast API — local dev config. Copy to `api/.env` (gitignored).
# Dev values below are fine as-is for local-first development.

ENVIRONMENT=development

# Postgres. In docker-compose the api service gets DATABASE_URL from compose
# (host `postgres`); this value is for running seed.py / alembic from the HOST,
# where Postgres is reachable on localhost:5432 (the mapped port).
DATABASE_URL=postgresql+psycopg://filecast:filecast_dev@localhost:5432/filecast
POSTGRES_PASSWORD=filecast_dev

# Sessions / cookies
SESSION_TTL_DAYS=30
# Leave COOKIE_DOMAIN unset locally; ".filecast.io" only in prod (Phase 7).
# COOKIE_DOMAIN=
COOKIE_SECURE=false
SITE_ORIGIN=http://localhost:8000

# Anti-abuse
FINGERPRINT_SALT=dev-salt
# Comma-separated peer IPs allowed to set X-Forwarded-For; empty locally.
TRUSTED_PROXIES=

# Retention
RETENTION_DAYS=30

# Google OAuth (Phase 5) — OPTIONAL. Only needed to test real Google sign-in
# locally; dev-login works without it. Leave the id/secret blank and the Google
# auth routes return 503 (header button lands on a 503 page) — that's expected,
# not a break. Create a Google Cloud "Web application" OAuth client with the
# redirect URI below, consent screen in Testing with your account as a test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8090/api/v1/auth/google/callback

# Dev cookie gotcha: use `localhost` consistently — a cookie set for host
# `localhost` is NOT sent to `127.0.0.1` and vice-versa. Same-site fetch
# :8000 -> :8090 works because ports don't affect same-site.
